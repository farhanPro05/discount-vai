# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgres://localhost:5432/discount_vai
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SSLCommerz (leave empty until the merchant account exists)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Development seed (npm run seed). The admin login it creates, and the demo customer password.
SEED_ADMIN_EMAIL=owner@discountvai.test
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_DEMO_PASSWORD=choose-a-demo-password

# Order emails (optional). Without SMTP_HOST, emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
